# App
NODE_ENV=development
PORT=3006
LOG_LEVEL=info
LOKI_URL=http://localhost:3100

# gRPC bind address
MEDIA_GRPC_URL=localhost:5006

# Messaging
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=kira_media

# S3-compatible storage (MinIO local — switch endpoint/keys for R2/S3)
S3_ENDPOINT=http://localhost:9000
# Optional: host clients use for PUT when it differs from S3_ENDPOINT (e.g. Docker)
# S3_PRESIGN_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=kira-media
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=http://localhost:9000/kira-media
S3_PRESIGN_TTL_SECONDS=300

# ╔══════════════════════════════════════════════════════════════════════╗
# ║  ALTERNATIVE STORAGE PLATFORMS                                      ║
# ║  Uncomment ONE block below and replace the MinIO vars above.        ║
# ║  All use the same S3-compatible API — no code changes needed.       ║
# ╚══════════════════════════════════════════════════════════════════════╝

# --- Cloudflare R2 (10 GB free, zero egress) ---
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=<R2_ACCESS_KEY_ID>
# S3_SECRET_ACCESS_KEY=<R2_SECRET_ACCESS_KEY>
# S3_BUCKET=kira-media
# S3_FORCE_PATH_STYLE=false
# S3_PUBLIC_BASE_URL=https://pub-<HASH>.r2.dev
# S3_PRESIGN_TTL_SECONDS=300

# --- AWS S3 ---
# S3_ENDPOINT=https://s3.<REGION>.amazonaws.com
# S3_REGION=<REGION>
# S3_ACCESS_KEY_ID=<AWS_ACCESS_KEY_ID>
# S3_SECRET_ACCESS_KEY=<AWS_SECRET_ACCESS_KEY>
# S3_BUCKET=kira-media
# S3_FORCE_PATH_STYLE=false
# S3_PUBLIC_BASE_URL=https://kira-media.s3.<REGION>.amazonaws.com
# S3_PRESIGN_TTL_SECONDS=300

# --- Backblaze B2 (10 GB free) ---
# S3_ENDPOINT=https://s3.<REGION>.backblazeb2.com
# S3_REGION=<REGION>
# S3_ACCESS_KEY_ID=<B2_APPLICATION_KEY_ID>
# S3_SECRET_ACCESS_KEY=<B2_APPLICATION_KEY>
# S3_BUCKET=kira-media
# S3_FORCE_PATH_STYLE=false
# S3_PUBLIC_BASE_URL=https://f005.backblazeb2.com/file/kira-media
# S3_PRESIGN_TTL_SECONDS=300

# --- Google Cloud Storage (S3-compatible interop) ---
# S3_ENDPOINT=https://storage.googleapis.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=<GCS_HMAC_ACCESS_ID>
# S3_SECRET_ACCESS_KEY=<GCS_HMAC_SECRET>
# S3_BUCKET=kira-media
# S3_FORCE_PATH_STYLE=false
# S3_PUBLIC_BASE_URL=https://storage.googleapis.com/kira-media
# S3_PRESIGN_TTL_SECONDS=300

# --- DigitalOcean Spaces ---
# S3_ENDPOINT=https://<REGION>.digitaloceanspaces.com
# S3_REGION=<REGION>
# S3_ACCESS_KEY_ID=<DO_SPACES_KEY>
# S3_SECRET_ACCESS_KEY=<DO_SPACES_SECRET>
# S3_BUCKET=kira-media
# S3_FORCE_PATH_STYLE=false
# S3_PUBLIC_BASE_URL=https://kira-media.<REGION>.digitaloceanspaces.com
# S3_PRESIGN_TTL_SECONDS=300

# --- Wasabi ---
# S3_ENDPOINT=https://s3.<REGION>.wasabisys.com
# S3_REGION=<REGION>
# S3_ACCESS_KEY_ID=<WASABI_ACCESS_KEY>
# S3_SECRET_ACCESS_KEY=<WASABI_SECRET_KEY>
# S3_BUCKET=kira-media
# S3_FORCE_PATH_STYLE=false
# S3_PUBLIC_BASE_URL=https://s3.<REGION>.wasabisys.com/kira-media
# S3_PRESIGN_TTL_SECONDS=300

# --- Vultr Object Storage ---
# S3_ENDPOINT=https://<HOSTNAME>.vultr.com
# S3_REGION=<REGION>
# S3_ACCESS_KEY_ID=<VULTR_ACCESS_KEY>
# S3_SECRET_ACCESS_KEY=<VULTR_SECRET_KEY>
# S3_BUCKET=kira-media
# S3_FORCE_PATH_STYLE=false
# S3_PUBLIC_BASE_URL=https://<HOSTNAME>.vultr.com/kira-media
# S3_PRESIGN_TTL_SECONDS=300

# --- Supabase Storage (S3-compatible) ---
# S3_ENDPOINT=https://<PROJECT_REF>.supabase.co/storage/v1/s3
# S3_REGION=<REGION>
# S3_ACCESS_KEY_ID=<SUPABASE_S3_ACCESS_KEY>
# S3_SECRET_ACCESS_KEY=<SUPABASE_S3_SECRET_KEY>
# S3_BUCKET=kira-media
# S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_BASE_URL=https://<PROJECT_REF>.supabase.co/storage/v1/object/public/kira-media
# S3_PRESIGN_TTL_SECONDS=300
