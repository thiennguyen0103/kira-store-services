# App
NODE_ENV=development
PORT=3005
LOG_LEVEL=info
LOKI_URL=http://localhost:3100
APP_PUBLIC_URL=http://localhost:3000

# gRPC bind address
IDENTITY_GRPC_URL=localhost:5005

# JWT (min 32 chars)
JWT_ACCESS_SECRET=dev-access-secret-change-me-32chars!!
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-32chars!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Email (Resend) — omit RESEND_API_KEY to log emails to the console instead
# Get a key at https://resend.com/api-keys
# Free test sender: onboarding@resend.dev (can only send to your Resend account email)
RESEND_API_KEY=
EMAIL_FROM=Kira Store <onboarding@resend.dev>

# Messaging
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=kira_identity

# Bootstrap admin (optional) — creates an ACTIVE ADMIN account on startup if missing.
# Password must be 8–128 chars and include at least one letter and one number.
SEED_ADMIN_EMAIL=admin@kira.store
SEED_ADMIN_PASSWORD=Admin123!
SEED_ADMIN_FIRST_NAME=Admin
SEED_ADMIN_LAST_NAME=User
