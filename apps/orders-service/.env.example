# App
NODE_ENV=development
PORT=3002
LOG_LEVEL=info
LOKI_URL=http://localhost:3100

# gRPC bind address
ORDERS_GRPC_URL=localhost:5002

# Downstream gRPC clients
PRODUCTS_GRPC_URL=localhost:5004
USERS_GRPC_URL=localhost:5001
PAYMENTS_GRPC_URL=localhost:5003

# Checkout
ORDER_PAYMENT_TIMEOUT_MINUTES=30
CHECKOUT_SUCCESS_URL=http://localhost:3000/checkout/success
CHECKOUT_CANCEL_URL=http://localhost:3000/checkout/cancel

# Messaging
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=kira_orders
