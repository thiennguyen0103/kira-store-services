# App
NODE_ENV=development
PORT=3003
LOG_LEVEL=info
LOKI_URL=http://localhost:3100

# gRPC bind address
PAYMENTS_GRPC_URL=localhost:5003

# Messaging
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=kira_payments

# Public base URL (webhook / mock checkout links)
PAYMENTS_PUBLIC_BASE_URL=http://localhost:3003

# Stripe (leave empty in local/dev to use DevMock gateway)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayOS (leave empty in local/dev to use DevMock gateway)
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
