# Optional overrides for Docker Compose variable substitution.
# Copy to `.env` if you need to change ports/credentials for the infra stack.
# Nest app env for the host workflow lives in apps/*/.env.example.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

LOKI_PORT=3100
GRAFANA_PORT=3200

# MinIO (S3-compatible local storage for media-service)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# API gateway CORS — `*` allows any origin; or comma-separated allowlist
CORS_ORIGINS=*
